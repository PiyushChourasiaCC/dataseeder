<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>true</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <endpoint>https://api.openai.com/v1</endpoint>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <label>LLM API</label>
    <principalType>NamedUser</principalType>
    <protocol>Password</protocol>
    <username>ApiUser</username>
    <!-- 
        IMPORTANT: Replace YOUR_API_KEY_PLACEHOLDER with your actual OpenAI API key when deploying to your org.
        For security, it's recommended to use a Named Credential Secret for the API key in production.
        This file should never contain the actual API key when stored in version control.
    -->
    <password>YOUR_API_KEY_PLACEHOLDER</password>
</NamedCredential> 